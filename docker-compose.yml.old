version: '2'
services:            
    apache:
        image: pavielex/wasapache:latest
        build: ./apache   
        container_name: wasapache
        ports:
            - 80:80
        depends_on:
            - maven-build
                      
    maven-build:
        image: pavielex/wasmaven:latest
        build: ./maven
        container_name: wasmaven
        restart: always
        ports:
            - 9080:9080
